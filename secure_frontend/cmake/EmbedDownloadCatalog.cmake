# Model downloads (plan docs/superpowers/plans/2026-10-23-model-downloads.md): embeds
# catalog/downloads.json (generated by tools/secure/download_catalog.py) into the server, so the
# download cards are a build input like the page, never a file read at run time. No file: an
# empty catalog. The same for tools/secure/prepare_download.py (the prepare step, D7): the script
# the server runs is the one it was built with. `function_name` is the accessor's name.
function(secure_frontend_embed_download_catalog source output function_name)
    if(EXISTS "${source}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
        file(READ "${source}" _hex HEX)
    else()
        set(_hex "")
    endif()
    if(_hex STREQUAL "")
        set(_body "constexpr char kBytes[] = {0x00};\nconstexpr std::size_t kSize = 0;\n")
    else()
        string(LENGTH "${_hex}" _hex_length)
        math(EXPR _size "${_hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
        set(_body "constexpr char kBytes[] = {${_bytes}};\nconstexpr std::size_t kSize = ${_size};\n")
    endif()
    file(WRITE "${output}.tmp"
        "// Generated by cmake/EmbedDownloadCatalog.cmake from ${source}. Do not edit.\n"
        "#include \"secure_frontend/download_catalog.hpp\"\n#include <cstddef>\n\n"
        "namespace secure_frontend {\nnamespace {\n${_body}}  // namespace\n\n"
        "std::string_view ${function_name}() noexcept { return std::string_view{kBytes, kSize}; }\n\n"
        "}  // namespace secure_frontend\n")
    file(COPY_FILE "${output}.tmp" "${output}" ONLY_IF_DIFFERENT)
endfunction()
