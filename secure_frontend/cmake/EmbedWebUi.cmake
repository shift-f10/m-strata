# The built-in chat page (listener.web_ui): embed secure_frontend/web/ into a generated C++
# source at configure time, so the server serves bundled bytes only and reads no file at run
# time. A text asset must be ASCII with LF line ends (HTML entities and JS escapes for anything
# else); a binary asset (the page's font) is embedded as it is. Any other byte in a text asset
# fails the configure step. Reconfigures when an asset changes.
#
#   secure_frontend_embed_web_ui(<output.cpp>)
function(secure_frontend_embed_web_ui output)
  # target|file|media type|text or binary (";" is CMake's list separator, so a text asset's
  # charset is added below).
  set(_assets
      "/|index.html|text/html|text"
      "/ui/theme.js|theme.js|text/javascript|text"
      "/ui/app.js|app.js|text/javascript|text"
      "/ui/tokens.css|tokens.css|text/css|text"
      "/ui/components.css|components.css|text/css|text"
      "/ui/app.css|app.css|text/css|text"
      "/ui/sprite.svg|sprite.svg|image/svg+xml|text"
      "/ui/favicon.svg|favicon.svg|image/svg+xml|text"
      "/ui/fonts/outfit-latin-wght.woff2|fonts/outfit-latin-wght.woff2|font/woff2|binary"
      "/ui/fonts/outfit-latin-ext-wght.woff2|fonts/outfit-latin-ext-wght.woff2|font/woff2|binary")
  set(_arrays "")
  set(_rows "")
  set(_index 0)
  foreach(_entry IN LISTS _assets)
    string(REPLACE "|" ";" _parts "${_entry}")
    list(GET _parts 0 _target)
    list(GET _parts 1 _file)
    list(GET _parts 2 _type)
    list(GET _parts 3 _kind)
    set(_path "${CMAKE_CURRENT_SOURCE_DIR}/web/${_file}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_path}")
    file(READ "${_path}" _hex HEX)
    string(LENGTH "${_hex}" _hex_length)
    if(_hex_length EQUAL 0)
      message(FATAL_ERROR "web/${_file} is empty")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    if(_kind STREQUAL "text")
      if(_bytes MATCHES "0x[89a-f][0-9a-f],")
        message(FATAL_ERROR "web/${_file} holds a non-ASCII byte; use an HTML entity or a \\u escape")
      endif()
      if(_bytes MATCHES "0x0d,")
        message(FATAL_ERROR "web/${_file} holds a carriage return; keep web/ at LF (.gitattributes)")
      endif()
      set(_type "${_type}; charset=utf-8")
    endif()
    string(APPEND _arrays "constexpr unsigned char kAsset${_index}[] = {${_bytes}};\n")
    string(APPEND _rows "      {\"${_target}\", \"${_type}\", bytes(kAsset${_index}, sizeof kAsset${_index})},\n")
    math(EXPR _index "${_index} + 1")
  endforeach()
  set(_text "// Generated by cmake/EmbedWebUi.cmake from secure_frontend/web/ - do not edit.\n")
  string(APPEND _text "#include \"secure_frontend/web_ui.hpp\"\n\n#include <array>\n#include <cstddef>\n\n")
  string(APPEND _text "namespace secure_frontend {\nnamespace {\n${_arrays}\n")
  string(APPEND _text "std::string_view bytes(const unsigned char* data, const std::size_t size) noexcept {\n")
  string(APPEND _text "  return std::string_view{reinterpret_cast<const char*>(data), size};\n}\n}  // namespace\n\n")
  string(APPEND _text "std::span<const WebAsset> web_ui_assets() noexcept {\n")
  string(APPEND _text "  static const std::array<WebAsset, ${_index}> kAssets{{\n${_rows}  }};\n")
  string(APPEND _text "  return kAssets;\n}\n\n}  // namespace secure_frontend\n")
  # Written through a temporary and copied only when different, so an unchanged page
  # never rebuilds the server.
  file(WRITE "${output}.tmp" "${_text}")
  configure_file("${output}.tmp" "${output}" COPYONLY)
endfunction()
